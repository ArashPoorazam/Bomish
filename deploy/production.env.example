# Nonsecret deployment configuration. Use separate files/projects/secrets for staging.
COMPOSE_PROJECT_NAME=bomish-production
SITE_HOST=bomish.ir
SITE_INDEXABLE=false
# Absolute directory outside the checkout; see docs/production.md.
SECRETS_DIR=/srv/bomish/secrets
# Fill these from the verified CI image artifact; use name@sha256:... digests.
API_IMAGE=
WEB_IMAGE=
BACKUP_IMAGE=
POSTGRES_IMAGE=postgres:18-alpine
TRAEFIK_IMAGE=traefik:v3.6
EDGE_SUBNET=172.30.10.0/24
# Get CURRENT ranges from https://www.cloudflare.com/ips/ and include both families.
CLOUDFLARE_CIDRS=
# Edge subnet above plus the exact same Cloudflare ranges. Never use 0.0.0.0/0.
TRUSTED_PROXY_CIDRS=
# Use an off-VPS S3-compatible bucket. Initialize explicitly before starting backup.
RESTIC_REPOSITORY=s3:https://YOUR-S3-ENDPOINT/YOUR-BUCKET/bomish-production
