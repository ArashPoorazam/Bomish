{
  "name": "bomish-web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=26 <27"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "next typegen && tsc --noEmit",
    "api:generate": "npm ci --prefix tools/api-types --ignore-scripts && npm run generate --prefix tools/api-types",
    "test:e2e": "playwright test",
    "format": "prettier --write src tests tools *.ts *.json",
    "format:check": "prettier --check src tests tools *.ts *.json",
    "test:production": "playwright test production-readiness.spec.ts"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "lucide-react": "^1.59.0",
    "next": "^16.4.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "streamdown": "^2.7.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2"
  }
}
