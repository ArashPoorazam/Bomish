# Local development only. Copy to .env for Docker Compose.
POSTGRES_PASSWORD=bomish-local-only
APP_ORIGIN=http://localhost:3000
SITE_URL=http://localhost:3000
SITE_INDEXABLE=false

# Private integrations. Copy to .env; never commit real keys.
NESHAN_API_KEY=
# SMS stays simulated unless explicitly enabled.
SMS_ENABLED=false
KAVENEGAR_API_KEY=
# Six approved Lookup templates; order templates embed APP_ORIGIN/account/orders/%token.
# See docs/integrations.md for Persian text and the activation checklist.
KAVENEGAR_VERIFY_TEMPLATE=
KAVENEGAR_PAID_TEMPLATE=
KAVENEGAR_PACKED_TEMPLATE=
KAVENEGAR_POST_TEMPLATE=
KAVENEGAR_SNAPP_TEMPLATE=
KAVENEGAR_DELIVERED_TEMPLATE=
# https://wa.me/989... or https://t.me/your_support
SUPPORT_URL=
# Confirmed Pishkhan24 barcode parameter; {tracking} is replaced safely.
POST_TRACKING_URL_TEMPLATE='https://pishkhan24.com/posttracking/?barcode={tracking}'

# Development only. False keeps live adapters disabled; this is not a live switch.
SHIPPING_SIMULATED=false
# Server-only placeholders. Presence never constitutes live verification.
SNAPP_API_KEY=
TAPIN_API_KEY=

# Native launcher defaults to config/shipping.json. Direct backend runs need an absolute path.
# SHIPPING_CONFIG_FILE=/absolute/path/to/Bomish/config/shipping.json

# Direct backend runs (native launcher and Compose set these automatically).
# APP_ENV=development
# DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/bomish?sslmode=disable
# LISTEN_ADDR=127.0.0.1:8080
# UPLOAD_DIR=/absolute/path/to/Bomish/.data/uploads
# SEED_DEMO=true
# Direct frontend runs; use the backend address reachable from the frontend server.
# API_URL=http://127.0.0.1:8080
# Optional separate Next.js build directory for local previews.
# BOMISH_DIST_DIR=.next
